# Copy this file to .env and fill in your own values. Never commit .env.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/msk-youth-club
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
ADMIN_EMAIL=admin@mskyouthclub.local
ADMIN_PASSWORD=change_this_to_a_strong_unique_password
# Optional comma-separated frontend origins, e.g. https://your-site.vercel.app
CLIENT_ORIGIN=http://localhost:5173
